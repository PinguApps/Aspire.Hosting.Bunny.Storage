{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>PinguApps/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)samples/BunnyStorageManual/AppHost/BunnyStorageManual\\.AppHost\\.csproj$/"
      ],
      "matchStrings": [
        "<Project Sdk=\"Aspire\\.AppHost\\.Sdk/(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "nuget",
      "depNameTemplate": "Aspire.AppHost.Sdk"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "/^Aspire\\./"
      ],
      "enabled": false
    },
    {
      "description": "Keep the Aspire 13.6 hosting dependency graph on Extensions 10; runtime client upgrades remain independent.",
      "matchFileNames": [
        "src/Aspire.Hosting.Bunny.Storage/Directory.Packages.props"
      ],
      "matchPackageNames": [
        "/^Microsoft\\.Extensions\\./"
      ],
      "allowedVersions": "<11"
    }
  ]
}
