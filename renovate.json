{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>PinguApps/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)samples/BunnyStorageManual/AppHost/BunnyStorageManual\\.AppHost\\.csproj$/"
      ],
      "matchStrings": [
        "<Project Sdk=\"Aspire\\.AppHost\\.Sdk/(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "nuget",
      "depNameTemplate": "Aspire.AppHost.Sdk"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "Aspire.AppHost.Sdk",
        "Aspire.Hosting",
        "Aspire.Hosting.Azure.Storage"
      ],
      "groupName": "aspire monorepo",
      "groupSlug": "aspire-monorepo"
    }
  ]
}
